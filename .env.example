# Optional local OAuth paths. Copy this file to .env only if your shell or
# environment loader reads it; the application also accepts these variables
# directly. Never commit the credential or token files.
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json

# Account identities, calendar IDs, OAuth tokens, and persistent browser data
# are stored under the ignored .calendar-anim/ directory, not in this file.
